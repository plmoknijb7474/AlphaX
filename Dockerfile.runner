FROM python:3.13.4-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8080 \
    ALPHA_RUNTIME_BACKEND=local

# Required Linux utilities for user/mount namespaces and the constrained chroot.
# The application probes host permissions and refuses user-code execution if blocked.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates coreutils util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-runner.txt ./requirements-runner.txt
RUN python -m pip install --no-cache-dir -r requirements-runner.txt
COPY runtime_sandbox.py railway_runner.py ./
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin alpha \
    && chown -R alpha:alpha /app
USER 10001:10001

EXPOSE 8080
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 4 --timeout 180 --access-logfile - --error-logfile - railway_runner:app"]
