# Copy to .env only for local development. Never commit .env.
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FLASK_SECRET_KEY=replace-with-a-long-random-secret
API_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
COOKIE_SECURE=0

# Leave DATABASE_URL empty to use local SQLite, or set a Supabase PostgreSQL URL.
DATABASE_URL=

# Keep user-code execution disabled unless the host passes the Linux sandbox probe.
ALPHA_RUNTIME_BACKEND=local
ALPHA_SANDBOX_ENABLED=0
