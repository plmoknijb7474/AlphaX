# Local development: local namespace sandbox, fail-closed if the kernel blocks it.
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FLASK_SECRET_KEY=replace-with-a-long-random-secret
API_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
COOKIE_SECURE=0

# PostgreSQL (Supabase or Railway PostgreSQL). Leave empty for local SQLite only.
DATABASE_URL=

# Local runtime settings. For Railway deployment see DEPLOY-RAILWAY-SUPABASE-AR.md.
ALPHA_RUNTIME_BACKEND=local
ALPHA_SANDBOX_ENABLED=0

# Required only for the web service when ALPHA_RUNTIME_BACKEND=railway.
# Use the Railway private hostname, e.g. http://alpha-runner.railway.internal:8080
ALPHA_RUNNER_URL=
# Generate one 48+ character random secret and set the same value on both services.
ALPHA_RUNNER_TOKEN=
